<?xml version="1.0" encoding="utf-8"?>
<!--
  ADR-0009: allowBackup="false" plus explicit exclusion of all domains from
  cloud backup and device transfer. The full Keystore-wrapped token store is
  thus never replicated off-device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
