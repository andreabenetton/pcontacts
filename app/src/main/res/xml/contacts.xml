<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-only
  SPDX-FileCopyrightText: 2026 pcontacts contributors

  Declares which ContactsContract data kinds the pcontacts account
  supports. Referenced from AndroidManifest.xml via
  android.provider.CONTACTS_STRUCTURE on the SyncAdapter service.

  The EditSchema makes the account writable for contacts editors:
  AOSP Contacts treats an external account as read-only without one
  (ExternalAccountType.areContactsWritable() returns mHasEditSchema)
  and leaves it out of the "Save contact to" picker. It lists only
  the kinds and types pcontacts carries both ways (ContactRow);
  group membership is left out because it is pull-only. AOSP
  requires every name attribute, phonetic ones included, to be true,
  and nickname, organization, note and photo to have maxOccurs="1".
-->
<ContactsAccountType xmlns:android="http://schemas.android.com/apk/res/android">

    <EditSchema>
        <DataKind
            kind="name"
            maxOccurs="1"
            supportsDisplayName="true"
            supportsPrefix="true"
            supportsMiddleName="true"
            supportsSuffix="true"
            supportsPhoneticFamilyName="true"
            supportsPhoneticMiddleName="true"
            supportsPhoneticGivenName="true" />
        <DataKind kind="photo" maxOccurs="1" />
        <DataKind kind="phone">
            <Type type="mobile" />
            <Type type="home" />
            <Type type="work" />
            <Type type="main" />
            <Type type="fax_work" />
            <Type type="fax_home" />
            <Type type="pager" />
            <Type type="other" />
        </DataKind>
        <DataKind kind="email">
            <Type type="other" />
        </DataKind>
        <DataKind kind="postal" needsStructured="true">
            <Type type="home" />
            <Type type="work" />
            <Type type="other" />
        </DataKind>
        <DataKind kind="organization" maxOccurs="1" />
        <DataKind kind="event" dateWithTime="false">
            <Type type="birthday" maxOccurs="1" yearOptional="true" />
            <Type type="anniversary" maxOccurs="1" yearOptional="true" />
        </DataKind>
        <DataKind kind="nickname" maxOccurs="1" />
        <DataKind kind="website" />
        <DataKind kind="im">
            <Type type="jabber" />
            <Type type="skype" />
            <Type type="aim" />
            <Type type="msn" />
            <Type type="yahoo" />
            <Type type="qq" />
            <Type type="google_talk" />
            <Type type="icq" />
            <Type type="custom" />
        </DataKind>
        <DataKind kind="note" maxOccurs="1" />
    </EditSchema>

    <!--
        ADR-0021: "Send via Proton Mail" per-email action chip. The
        custom MIMETYPE is written by :core:contacts-writer
        (PContactsMimeTypes.SEND_VIA_PROTON_MAIL); the row's icon and
        label render via this ContactsDataKind entry on apps that
        honor it (AOSP Contacts), or via the matching activity's
        android:icon + android:label on apps that use the
        intent-filter discovery path (Fossify).
    -->
    <ContactsDataKind
        android:mimeType="vnd.android.cursor.item/vnd.io.pcontacts.send_via_proton_mail"
        android:icon="@drawable/ic_send_via_proton_mail"
        android:summaryColumn="data2"
        android:detailColumn="data1" />

</ContactsAccountType>
