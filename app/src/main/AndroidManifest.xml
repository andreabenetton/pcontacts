<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for Proton API (ADR-0012). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Account + sync wiring (ADR-0004). Declared up front so future commits
         (authenticator service, sync adapter) only need to add the service
         elements, not bump permissions in a separate commit. -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />

    <!-- Contacts. WRITE_CONTACTS is required for the SyncAdapter to write
         RawContacts under our account type (ADR-0010). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Notifications for sync errors on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility for the READ_CONTACTS transparency feature in
         Settings. Without this, Android 11+ hides third-party apps from
         getInstalledPackages(), making the list incomplete. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".PcontactsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pcontacts"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AccountAuthenticator.addAccount Intent target (ADR-0004). Exported
             false because launching happens via AccountManager binding, not
             external Intent dispatch. -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Pcontacts" />

        <!-- Settings surface: Sync Now + Sign Out. Exported so MainActivity
             can launch it directly (no cross-app intent dispatch needed). -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Pcontacts" />

        <!-- ADR / plan §20 - In-app WebView that hosts Proton's hosted
             captcha page (`verify.proton.me`) and writes the resulting
             verification token into SecretStore. Replaces the previous
             Chrome Custom Tabs flow whose cookie jar never shared with
             our OkHttp client. -->
        <activity
            android:name=".verification.HumanVerificationActivity"
            android:exported="false"
            android:theme="@style/Theme.Pcontacts" />

        <!-- ADR-0021: tap target for the per-email "Send via Proton
             Mail" chip rendered next to every Email row on a Proton
             contact. Exported true so Android's Contacts UI can
             dispatch ACTION_VIEW on the row's Data URI. NoDisplay +
             noHistory because the activity is a thin intent router
             that never draws a window. -->
        <activity
            android:name=".intent.SendViaProtonMailActivity"
            android:exported="true"
            android:icon="@drawable/ic_send_via_proton_mail"
            android:label="@string/chip_send_via_proton_mail"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.io.pcontacts.send_via_proton_mail" />
            </intent-filter>
        </activity>

        <!-- ADR-0004: AccountAuthenticator surface. The android:exported="true"
             is required for AccountManager to bind across processes; the
             intent-filter restricts who can use the binding. -->
        <service
            android:name=".account.ProtonAuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <!-- ADR-0004: SyncAdapter surface for ContactsContract.AUTHORITY.
             android:exported="true" is required for the sync framework to bind. -->
        <service
            android:name=".sync.ProtonSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts" />
        </service>

    </application>

</manifest>
